# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ──────────────────────────────────────────────
# RabbitMQ (provisioned for the deferred async-messaging design)
# ──────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
# Must be at least 32 characters; the backend's placeholder secret is
# rejected at startup outside Development by every service and the gateway.
JWT_SECRET_KEY=dev-only-secret-change-me-32-chars-min
JWT_ISSUER=EventNest.AuthService
JWT_AUDIENCE=EventNest
JWT_ACCESS_EXPIRY=60
JWT_REFRESH_EXPIRY=30

# ──────────────────────────────────────────────
# Browser / UI
# ──────────────────────────────────────────────
CORS_ALLOWED_ORIGIN_0=http://localhost:5173
CORS_ALLOWED_ORIGIN_1=https://localhost:5173
# Local HTTP only — set to true when serving the stack behind HTTPS.
COOKIE_SECURE=false

# ──────────────────────────────────────────────
# ASP.NET Core
# ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
